{
  "name": "easy-webcomp",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": [
    "dist",
    "src/tokens/tokens.css"
  ],
  "exports": {
    "./tokens.css": "./src/tokens/tokens.css",
    "./element-plus.css": "./dist/element-plus.css",
    "./cdn/*": "./dist/cdn/*.js"
  },
  "scripts": {
    "dev": "vite devtools",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "snapshot": "tsx scripts/snapshot.ts",
    "icons:sync": "tsx scripts/icons.ts",
    "new:workspace": "tsx scripts/new-workspace.ts",
    "new:component": "tsx scripts/new-component.ts",
    "build": "tsx scripts/build.ts",
    "build:esm": "tsx scripts/build.ts --only=esm",
    "build:cdn": "tsx scripts/build.ts --only=cdn",
    "build:framework": "tsx scripts/build.ts --only=framework",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:artifacts": "tsx scripts/check-artifacts.ts",
    "check:framework": "vitest run --config vitest.integration.config.ts",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:artifacts && pnpm run check:framework && pnpm run docs:build && pnpm run test:e2e"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@ew/runtime": "workspace:*",
    "@ew/utils": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.104.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitepress": "1.6.4",
    "vitest": "^3.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
