{
  "name": "easy-webcomp",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": [
    "dist",
    "src/tokens/tokens.css"
  ],
  "exports": {
    "./tokens.css": "./src/tokens/tokens.css",
    ".": "./dist/esm/index.js",
    "./hello-react": "./dist/esm/hello-react.js",
    "./hello-react/define": "./dist/esm/hello-react/define.js",
    "./cdn/hello-react": "./dist/cdn/hello-react.js",
    "./hello-vue": "./dist/esm/hello-vue.js",
    "./hello-vue/define": "./dist/esm/hello-vue/define.js",
    "./cdn/hello-vue": "./dist/cdn/hello-vue.js",
    "./cdn/ew-all": "./dist/cdn/ew-all.js"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "new:workspace": "tsx scripts/new-workspace.ts",
    "build": "tsx scripts/build.ts",
    "build:esm": "tsx scripts/build.ts --only=esm",
    "build:cdn": "tsx scripts/build.ts --only=cdn",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run docs:build && pnpm run test:e2e"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "jsdom": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitepress": "1.6.4",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
